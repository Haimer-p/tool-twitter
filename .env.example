GEMINI_API_KEY=your_gemini_api_key_here
# Nhiều key Gemini — phân cách bằng dấu phẩy hoặc xuống dòng. Key lỗi/quota sẽ tắt đến 0h UTC ngày hôm sau.
# GEMINI_API_KEYS=key1,key2,key3
# Hoặc: GEMINI_API_KEY_1=... GEMINI_API_KEY_2=...
GEMINI_MODEL=gemini-2.5-flash

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat
# alternate | gemini | deepseek — ưu tiên Gemini khi có nhiều key
AI_STRATEGY=alternate

# MongoDB Atlas — free tier (M0)
# https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/twitter_bot?retryWrites=true&w=majority

DASHBOARD_PORT=3001
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=admin123

# Mã hóa cookies trong MongoDB (cùng key trên Vercel + máy local worker)
COOKIE_ENCRYPTION_KEY=change-me-to-random-32-chars-min

# Worker local (npm run worker)
WORKER_ID=my-pc-1
WORKER_POLL_MS=4000

BROWSER_HEADLESS=false
# PROXY_SERVER=host:port

# Health check (dashboard + npm run health-check)
HEALTH_CHECK_KEYWORD=crypto
HEALTH_CHECK_REPLY_TEXT=Health check test

# Account suspend appeal (npm run appeal)
APPEAL_FORM_URL=https://help.x.com/en/forms/account-access/appeals
APPEAL_LANGUAGE=en
APPEAL_TYPING_MIN_MS=80
APPEAL_TYPING_MAX_MS=200
APPEAL_CAPTCHA_TIMEOUT_MS=600000
APPEAL_MIN_LENGTH=150
APPEAL_MAX_LENGTH=500
